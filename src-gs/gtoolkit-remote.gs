category: 'accessing'
method: GtRmMovieCollection
groupDataBy: aBlock
	| groups |
	groups := Dictionary new.
	rawData do: [ :each |
		| key |
		key := aBlock value: each.
		key ifNotNil: [
		(groups 
			at: key
			ifAbsentPut: [ OrderedCollection new ]) add: each ] ].
	^ groups
%

category: 'accessing'
method: GtRmMovieCollection
