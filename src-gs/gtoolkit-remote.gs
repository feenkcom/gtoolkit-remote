	self isDirectory
		ifFalse: [ ^ aView empty ].

	^ aView columnedList
		title: 'Items';
		priority: 1;
		items: [ self gtChildrenWithParent ];
		column: 'Icon' 
			iconName: [ :each | 
				each isDirectory
					ifTrue: [ #emptyPackage ]
					ifFalse: [ #workspace ] ]
			width: 35;
		column: 'Name'  text: [ :each | 
			(self isChildOf: each)
				ifTrue: [ '..' ]
