category: 'converting'
method: GtRemotePhlowTreeNode
asDictionaryForExport
	| exportDictionary  |
	exportDictionary := super asDictionaryForExport.

	self childNodes ifNotNil: [ :aCollection |
		exportDictionary 
			at: #childNodes 
			put: (aCollection
				collect: [ :aChildNode | aChildNode asDictionaryForExport ])].
	
	^ exportDictionary
%

category: 'accessing'
method: GtRemotePhlowTreeNode
