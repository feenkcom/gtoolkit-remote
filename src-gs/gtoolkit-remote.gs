category: 'accessing'
method: GtRmGeoGpsTrajectoriesGroup
allRecords
	^ self 
		cacheAt: 'allRecords' 
		ifAbsentPut: [  
			self items
				inject: GtRmGeoGpsRecordsGroup new 
				into: [ :records :aTrajectory |
					records addAll: aTrajectory records items.
					records ] ]
