method: GtPhlowRuns
gtViewIntervalsFor: aView
	<gtView>
	
	^ aView columnedList 
		title: 'Intervals';
		priority: 10;
		items: [ 
			| collectedRuns |
			collectedRuns := OrderedCollection new.
			self runsDo: [ :aRun |
				collectedRuns add: aRun ].
			collectedRuns ];
		column: 'Interval' 
			text: [ :aRun | aRun rangeDescription ]
			width: 150;
		column: 'Attributes' 
			text: [ :aRun | aRun attributesDescription ]
